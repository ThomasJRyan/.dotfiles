{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@prevalentware/opencode-goal-plugin",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" }
    ]
  }
}
