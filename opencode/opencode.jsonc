{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "@prevalentware/opencode-goal-plugin"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "read": {
      "~/.config/opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/gsd-core/*": "allow"
    }
  },
  "mcp": {
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ],
      "enabled": true
    }
  }
}
