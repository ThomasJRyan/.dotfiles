prefix_rule(pattern=["uv", "sync"], decision="allow")
prefix_rule(pattern=["uv", "run", "pycalc"], decision="allow")
prefix_rule(pattern=["chmod", "+x"], decision="allow")
prefix_rule(pattern=["python3", "-m", "py_compile"], decision="allow")
prefix_rule(pattern=["printenv", "PATH"], decision="allow")
prefix_rule(pattern=["cargo", "build"], decision="allow")
prefix_rule(pattern=["cargo", "--version"], decision="allow")
prefix_rule(pattern=["rustup", "toolchain", "list"], decision="allow")
prefix_rule(pattern=["rustc", "--version"], decision="allow")
prefix_rule(pattern=["cargo", "fmt"], decision="allow")
prefix_rule(pattern=["cargo", "test"], decision="allow")
prefix_rule(pattern=["cargo", "metadata", "--format-version", "1", "--no-deps"], decision="allow")
prefix_rule(pattern=["rustup", "--version"], decision="allow")
prefix_rule(pattern=["rustup", "toolchain", "install"], decision="allow")
prefix_rule(pattern=["timeout", "5s", "cargo", "run"], decision="allow")
